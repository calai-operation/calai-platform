PORT=5000
NODE_ENV=production

# JWT Configuration
JWT_SECRET_TOKEN=your_jwt_secret_here
JWT_REFRESH_TOKEN=your_jwt_refresh_token_here
JWT_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=30d

# Database & Cache
DATABASE_URL=postgresql://postgres:password@localhost:5432/calai?schema=public
BACKEND_URL=http://localhost:5000
REDIS_URL=redis://localhost:6379
FRONT_END_URL=http://localhost:3000
AI_SERVICE_URL=http://localhost:8000

# Vapi Integration
VAPI_API_KEY=your_vapi_api_key_here

# SMTP / Email
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=user@example.com
SMTP_PASS=your_smtp_password
SMTP_FROM="Calai Orders <orders@example.com>"

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/v1/auth/google/callback

# Optional Operations & Twilio
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_AUTH_TOKEN=
CALAI_VAPI_BASE_URL=
CALAI_VAPI_KEY=
UNCONFIRMED_ASSISTANTS=
