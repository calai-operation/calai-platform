<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Order Confirmation - <%= order.businessName || 'Order' %></title>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap');
        
        body {
            font-family: 'Inter', sans-serif;
            background-color: #ffffff;
            color: #1e293b;
            margin: 0;
            padding: 30px;
            -webkit-print-color-adjust: exact;
        }
        .container {
            max-width: 800px;
            margin: 0 auto;
            background-color: #ffffff;
        }
        
        /* Premium Gradient Header Accent */
        .header-accent {
            height: 6px;
            background: linear-gradient(90deg, #4f46e5 0%, #7c3aed 50%, #db2777 100%);
            border-radius: 3px;
            margin-bottom: 35px;
        }
        
        /* Top Brand Header */
        .brand-section {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            margin-bottom: 40px;
        }
        .brand-left {
            display: flex;
            align-items: center;
            gap: 15px;
        }
        .logo-badge {
            width: 52px;
            height: 52px;
            background: linear-gradient(135deg, #4f46e5 0%, #7c3aed 100%);
            color: #ffffff;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 800;
            font-size: 20px;
            box-shadow: 0 4px 12px rgba(79, 70, 229, 0.2);
            text-transform: uppercase;
        }
        .brand-name-addr h2 {
            margin: 0;
            font-size: 20px;
            font-weight: 700;
            color: #0f172a;
            letter-spacing: -0.025em;
        }
        .brand-name-addr p {
            margin: 4px 0 0 0;
            font-size: 13px;
            color: #64748b;
            line-height: 1.4;
        }
        .brand-right {
            text-align: right;
        }
        .invoice-title {
            font-size: 24px;
            font-weight: 800;
            color: #0f172a;
            margin: 0 0 6px 0;
            letter-spacing: -0.03em;
            text-transform: uppercase;
        }
        .meta-pill {
            display: inline-block;
            background-color: #f1f5f9;
            color: #475569;
            font-size: 11px;
            font-weight: 600;
            padding: 4px 12px;
            border-radius: 20px;
            text-transform: uppercase;
            letter-spacing: 0.05em;
        }

        /* 2-Column Info Grid */
        .info-grid {
            display: grid;
            grid-template-columns: 1.2fr 0.8fr;
            gap: 30px;
            border-top: 1px solid #e2e8f0;
            border-bottom: 1px solid #e2e8f0;
            padding: 25px 0;
            margin-bottom: 30px;
        }
        .info-col h3 {
            margin: 0 0 12px 0;
            font-size: 12px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            color: #64748b;
        }
        .info-details {
            font-size: 14px;
            line-height: 1.6;
            color: #334155;
        }
        .info-details p {
            margin: 0 0 6px 0;
        }
        .info-details p:last-child {
            margin-bottom: 0;
        }
        .info-details strong {
            color: #0f172a;
        }
        
        /* Message Card */
        .message-card {
            background-color: #f8fafc;
            border-left: 4px solid #4f46e5;
            padding: 16px 20px;
            border-radius: 0 8px 8px 0;
            margin-bottom: 35px;
            font-size: 14px;
            line-height: 1.6;
            color: #475569;
        }
        .message-card strong {
            color: #0f172a;
        }

        /* Table Styling */
        .order-title {
            font-size: 15px;
            font-weight: 700;
            color: #0f172a;
            margin-bottom: 15px;
            letter-spacing: -0.01em;
            text-transform: uppercase;
        }
        table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 30px;
        }
        th {
            background-color: #f8fafc;
            color: #475569;
            font-size: 11px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            padding: 12px 16px;
            text-align: left;
            border-bottom: 2px solid #e2e8f0;
        }
        td {
            padding: 16px;
            font-size: 14px;
            color: #334155;
            border-bottom: 1px solid #e2e8f0;
            vertical-align: middle;
        }
        tr:last-child td {
            border-bottom: none;
        }
        .text-center {
            text-align: center;
        }
        .text-right {
            text-align: right;
        }
        .item-no {
            font-weight: 500;
            color: #94a3b8;
            width: 50px;
        }
        .product-name {
            font-weight: 600;
            color: #0f172a;
        }
        .qty {
            color: #475569;
            width: 80px;
            text-align: center;
            font-weight: 500;
        }
        .price {
            width: 110px;
            text-align: right;
            font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
            font-size: 14px;
            font-weight: 500;
        }
        .empty-table {
            text-align: center;
            color: #94a3b8;
            font-style: italic;
            padding: 40px;
        }

        /* Totals Block */
        .totals-section {
            display: flex;
            justify-content: flex-end;
            margin-bottom: 40px;
        }
        .totals-box {
            width: 320px;
            background-color: #f8fafc;
            border-radius: 12px;
            padding: 20px;
            border: 1px solid #f1f5f9;
        }
        .totals-row {
            display: flex;
            justify-content: space-between;
            margin-bottom: 10px;
            font-size: 14px;
            color: #64748b;
        }
        .totals-row.grand-total {
            margin-bottom: 0;
            margin-top: 12px;
            padding-top: 12px;
            border-top: 1px dashed #cbd5e1;
            color: #0f172a;
            font-size: 18px;
            font-weight: 700;
        }
        .totals-row.grand-total .total-amount {
            color: #4f46e5;
        }

        /* Footer Section */
        .footer {
            border-top: 1px solid #e2e8f0;
            padding-top: 30px;
            font-size: 12px;
            color: #64748b;
            line-height: 1.6;
        }
        .footer-grid {
            display: grid;
            grid-template-columns: 1.3fr 0.7fr;
            gap: 30px;
        }
        .footer-left p {
            margin: 0 0 10px 0;
        }
        .footer-left p:last-child {
            margin-bottom: 0;
        }
        .footer-right {
            text-align: right;
        }
        .signature-title {
            font-weight: 600;
            color: #0f172a;
            margin-top: 12px;
        }
    </style>
</head>
<body>
    <div class="container">
        <!-- Top Gradient Accent Line -->
        <div class="header-accent"></div>

        <!-- Header -->
        <div class="brand-section">
            <div class="brand-left">
                <% 
                  let initials = 'AI';
                  if (order.businessName) {
                    initials = order.businessName.split(' ').map(n => n[0]).join('').substring(0, 3).toUpperCase();
                  }
                %>
                <div class="logo-badge"><%= initials %></div>
                <div class="brand-name-addr">
                    <h2><%= order.businessName || 'Business Owner' %></h2>
                    <p><%= order.businessAddress || 'Voice Ordering System' %></p>
                </div>
            </div>
            <div class="brand-right">
                <h1 class="invoice-title">Order Receipt</h1>
                <span class="meta-pill">ID: <%= order.id ? order.id.split('-')[0] : 'N/A' %></span>
            </div>
        </div>

        <!-- Info Grid -->
        <div class="info-grid">
            <div class="info-col">
                <h3>Customer Details</h3>
                <div class="info-details">
                    <p><strong>Name:</strong> <%= order.customerName || 'N/A' %></p>
                    <p><strong>Phone:</strong> <%= order.customerNumber || 'N/A' %></p>
                    <% if (order.orderType === 'DELIVERY' && order.deliveryAddress) { %>
                        <p><strong>Delivery Address:</strong> <%= order.deliveryAddress %></p>
                    <% } %>
                </div>
            </div>
            <div class="info-col">
                <h3>Order Info</h3>
                <div class="info-details">
                    <p><strong>Date:</strong> <%= order.date || 'N/A' %></p>
                    <p><strong>Time:</strong> <%= order.time || 'N/A' %></p>
                    <p><strong>Order Type:</strong> <%= order.orderType || 'PICKUP' %></p>
                    <p><strong>Status:</strong> Confirmed</p>
                </div>
            </div>
        </div>

        <!-- Message Box -->
        <div class="message-card">
            Dear <strong><%= order.customerName || 'Customer' %></strong>,<br>
            Thank you for confirming the order details during our voice call. We have successfully processed your request. Below is a detailed breakdown of your order.
        </div>

        <!-- Table -->
        <div class="order-title">Itemized Details</div>
        <table>
            <thead>
                <tr>
                    <th class="item-no text-center">No</th>
                    <th>Product Name</th>
                    <th class="qty text-center">Qty</th>
                    <th class="text-right">Unit Price</th>
                    <th class="text-right">Subtotal</th>
                </tr>
            </thead>
            <tbody>
                <%
                  let itemsList = [];
                  if (order.items) {
                    if (typeof order.items === 'string') {
                      try {
                        itemsList = JSON.parse(order.items);
                      } catch (e) {
                        itemsList = [];
                      }
                    } else if (Array.isArray(order.items)) {
                      itemsList = order.items;
                    }
                  }
                %>
                <% if (itemsList && itemsList.length > 0) { %>
                    <% itemsList.forEach((item, index) => { %>
                        <%
                          let name = item.product_name || item.item_name || item.name || 'N/A';
                          let qty = parseInt(item.quantity) || 1;
                          let unitPriceRaw = item.unit_prize || item.unit_price;
                          let unitPrice = unitPriceRaw ? parseFloat(unitPriceRaw) : null;
                          let totalPrice = item.total_price ? parseFloat(item.total_price) : (unitPrice ? qty * unitPrice : null);
                        %>
                        <tr>
                            <td class="item-no text-center"><%= (index + 1).toString().padStart(2, '0') %></td>
                            <td class="product-name"><%= name %></td>
                            <td class="qty text-center"><%= qty %></td>
                            <td class="price"><%= unitPrice ? '£' + unitPrice.toFixed(2) : '-' %></td>
                            <td class="total price"><%= totalPrice ? '£' + totalPrice.toFixed(2) : '-' %></td>
                        </tr>
                    <% }); %>
                <% } else { %>
                    <tr>
                        <td colspan="5" class="empty-table">No items recorded in structured data.</td>
                    </tr>
                <% } %>
            </tbody>
        </table>

        <!-- Totals -->
        <div class="totals-section">
            <div class="totals-box">
                <div class="totals-row grand-total" style="border-top: none; padding-top: 0; margin-top: 0;">
                    <span>Total Order Amount</span>
                    <span class="total-amount">£<%= order.totalPrice ? parseFloat(order.totalPrice).toFixed(2) : '0.00' %></span>
                </div>
            </div>
        </div>

        <!-- Footer -->
        <div class="footer">
            <div class="footer-grid">
                <div class="footer-left">
                    <p>We appreciate your business. If you have any questions or require changes to this order, please contact our support desk.</p>
                    <p>&copy; <%= new Date().getFullYear() %> <%= order.businessName || 'Voice Ordering Platform' %>. All rights reserved.</p>
                </div>
                <div class="footer-right">
                    <p>Processed securely by</p>
                    <div class="signature-title">AI Voice Ordering Platform</div>
                </div>
            </div>
        </div>
    </div>
</body>
</html>
