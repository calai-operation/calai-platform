<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Call Summary</title>
    <style>
      body {
        font-family: "Inter", "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
        background-color: #ffffff;
        color: #333333;
        margin: 0;
        padding: 20px;
      }
      .container {
        max-width: 800px;
        margin: 0 auto;
        background-color: #ffffff;
        padding: 20px;
      }
      h1 {
        text-align: center;
        font-size: 24px;
        margin-bottom: 30px;
        color: #000000;
        border-bottom: 2px solid #eeeeee;
        padding-bottom: 10px;
      }
      .info-section {
        display: flex;
        gap: 40px;
        margin-bottom: 25px;
        background-color: #f8f9fa;
        padding: 15px;
        border-radius: 4px;
      }
      .info-item {
        font-size: 14px;
      }
      .info-label {
        font-weight: 600;
        color: #555555;
        margin-right: 5px;
      }
      .section-title {
        font-size: 18px;
        font-weight: bold;
        margin: 25px 0 10px 0;
        color: #000000;
        border-left: 4px solid #007bff;
        padding-left: 10px;
      }
      .summary-content {
        line-height: 1.6;
        color: #333333;
        background-color: #ffffff;
        padding: 10px;
        border: 1px solid #dee2e6;
        border-radius: 4px;
      }
      .footer {
        margin-top: 40px;
        text-align: center;
        font-size: 12px;
        color: #777777;
        border-top: 1px solid #eeeeee;
        padding-top: 20px;
      }
    </style>
  </head>
  <body>
    <div class="container">
      <h1>Call Summary Report</h1>

      <div class="info-section">
        <div class="info-item">
          <span class="info-label">Date:</span> <%= order.date %>
        </div>
        <div class="info-item">
          <span class="info-label">Time:</span> <%= order.time %>
        </div>
        <div class="info-item">
          <span class="info-label">Duration:</span> <%= order.duration %>
        </div>
      </div>

      <div class="section-title">AI Summary</div>
      <div class="summary-content"><%= order.summary %></div>

      <div class="footer">
        Generated by Calai AI Voice Platform - <%= new
        Date().toLocaleDateString("en-GB", { timeZone: "Europe/London" }) %>
      </div>
    </div>
  </body>
</html>
