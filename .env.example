# ==============================================================================
# 🌐 GLOBAL & SYSTEM CONFIGURATION (Common across services)
# ==============================================================================
NODE_ENV=production
PORT=8000
TZ=Europe/London

# Domain Endpoints & Service Routing
BACKEND_URL=https://api.calai.info
FRONT_END_URL=https://calai.info
AI_SERVICE_URL=http://ai-service:8000
EXTERNAL_BACKEND_URL=http://backend:8000/api/webhook/vapi

# Shared Vapi AI Credentials
VAPI_API_KEY=your_vapi_api_key
VAPI_PUBLIC_KEY=your_vapi_public_key

# ==============================================================================
# 🖥️ FRONTEND CONFIGURATION & BUILD ARGS
# ==============================================================================
VITE_API_BASE_URL=https://api.calai.info/api
VITE_VAPI_PUBLIC_KEY=your_vapi_public_key

# EmailJS (Contact Form)
VITE_EMAILJS_SERVICE_ID=your_emailjs_service_id
VITE_EMAILJS_TEMPLATE_ID=your_emailjs_template_id
VITE_EMAILJS_ENTERPRISE_TEMPLATE_ID=your_emailjs_enterprise_template_id
VITE_EMAILJS_PUBLIC_KEY=your_emailjs_public_key

# ==============================================================================
# ⚙️ BACKEND SERVICE CONFIGURATION
# ==============================================================================
# Database Configuration (PostgreSQL + Prisma)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_secure_postgres_password
POSTGRES_DB=calai_voice_db
DATABASE_URL=postgresql://postgres:change_me_secure_postgres_password@postgres:5432/calai_voice_db?schema=public

# Redis Configuration (Internal Docker Service)
REDIS_URL=redis://redis:6379

# JWT Authentication Secrets
JWT_SECRET_TOKEN=change_me_super_secret_jwt_token_key_prod
JWT_REFRESH_TOKEN=change_me_super_secret_jwt_refresh_key_prod
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=7d

# NodeMailer (SMTP Mailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM=your_email@gmail.com

# Google OAuth Credentials
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=https://api.calai.info/api/auth/google/callback

# Stripe Payment Gateway
STRIPE_SECRET_KEY=sk_live_change_me
STRIPE_WEBHOOK_SECRET=whsec_change_me

# ==============================================================================
# 🤖 AI SERVICE CONFIGURATION
# ==============================================================================
# OpenAI LLM
OPENAI_API_KEY=sk-proj-your_openai_api_key
LLM_MODEL=gpt-4o

# VAPI Extra Settings
VAPI_DEFAULT_TOOL_ID=your_vapi_tool_id
VAPI_SERVER_URL=https://api.calai.info/api/webhook/vapi

# Twilio Telephony (Optional)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
